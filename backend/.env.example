GOOGLE_PLACES_API_KEY=
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/leadflow
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
# development | test | production — production fails fast on missing SECRET_KEY / mock providers
APP_ENV=development
SECRET_KEY=change-me-in-production-use-32plus-chars
# Phase 12 — auth
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7
AUTH_REQUIRED=true
# Comma-separated extras (FRONTEND_URL always included)
CORS_ORIGINS=

# Offline QA only (default false). Never enable in production.
GOOGLE_PLACES_MOCK=false

# Phase 4 — email verification
# Provider: empty/none = always unknown | mock = offline QA only | http = custom JSON API
EMAIL_VERIFICATION_PROVIDER=
EMAIL_VERIFICATION_API_KEY=
EMAIL_VERIFICATION_API_URL=
VERIFICATION_CACHE_DAYS=30
VERIFICATION_REQUEST_DELAY_SECONDS=0.25
VERIFICATION_MAX_BATCH=100

# Phase 5 — AI qualification
# Provider: empty/none = unconfigured | mock = offline QA only | openai = OpenAI
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=
AI_PROMPT_VERSION=v1.0
AI_MAX_TOKENS=1200
AI_TIMEOUT_SECONDS=45
AI_REQUEST_DELAY_SECONDS=0.35
AI_MAX_BATCH=50
AI_MAX_RETRIES=2

# Phase 6 — personalized outreach drafts (NO sending)
OUTREACH_PROMPT_VERSION=v1.0
OUTREACH_MAX_TOKENS=900
OUTREACH_MAX_BATCH=50
OUTREACH_REQUEST_DELAY_SECONDS=0.35
OUTREACH_ALLOW_UNKNOWN_VERIFICATION=false
AGENCY_NAME=LeadFlow AI

# Phase 7 — email sending (defaults prevent accidental real sends)
EMAIL_SENDING_PROVIDER=
EMAIL_SENDING_API_KEY=
EMAIL_SENDING_API_URL=
EMAIL_WEBHOOK_SECRET=
SENDER_EMAIL=
SENDER_NAME=LeadFlow AI
# Explicit opt-in required for live sending; credentials alone do NOT enable sends
EMAIL_SEND_ENABLED=false
EMAIL_TEST_MODE=true
MAX_EMAILS_PER_HOUR=20
MAX_EMAILS_PER_DAY=100
EMAIL_SEND_MAX_RETRIES=2
EMAIL_SEND_TIMEOUT_SECONDS=20
PUBLIC_APP_URL=http://localhost:5173

# Phase 8 — campaigns
CAMPAIGN_SEND_START_HOUR=9
CAMPAIGN_SEND_END_HOUR=17
CAMPAIGN_DEFAULT_TIMEZONE=UTC
CAMPAIGN_SCHEDULER_BATCH_SIZE=25
CAMPAIGN_LOCK_TTL_SECONDS=120

# Phase 9 — replies (inbound disabled unless explicitly enabled)
REPLY_PROMPT_VERSION=v1.0
REPLY_MAX_TOKENS=800
REPLY_AUTO_CLASSIFY=true
REPLY_AUTO_SUGGEST=true
REPLY_INBOUND_ENABLED=false

# Phase 10 — meetings / calendar (empty = not configured; mock = QA only)
CALENDAR_PROVIDER=
CALENDAR_API_KEY=
MEETING_DEFAULT_TIMEZONE=UTC
MEETING_BOOKING_TOKEN_TTL_DAYS=14
MEETING_SLOT_INTERVAL_MINUTES=30
MEETING_SEND_CONFIRMATIONS=true

# Phase 11 — production hardening
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_SENSITIVE_PER_MINUTE=30
PUBLIC_BOOKING_RATE_LIMIT_PER_MINUTE=20
JOB_QUEUE_BACKEND=local
JOB_DEFAULT_MAX_ATTEMPTS=3
FAIL_FAST_ON_INVALID_CONFIG=true

# Phase 14 — provider go-live readiness
PROVIDER_TEST_EMAIL=
PROVIDER_TEST_RATE_LIMIT_PER_MINUTE=5
CALENDAR_TEST_CALENDAR_ID=

# Phase 13 — SaaS billing (default unconfigured; Free plan works without Stripe)
# unconfigured | mock | stripe — never use mock in production
BILLING_PROVIDER=unconfigured
BILLING_TEST_MODE=true
BILLING_GRACE_PERIOD_DAYS=3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
PLAN_CURRENCY=USD
PLAN_PRICE_STARTER_MONTHLY=29
PLAN_PRICE_STARTER_ANNUAL=290
PLAN_PRICE_GROWTH_MONTHLY=99
PLAN_PRICE_GROWTH_ANNUAL=990
PLAN_PRICE_AGENCY_MONTHLY=299
PLAN_PRICE_AGENCY_ANNUAL=2990
